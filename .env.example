# Optional legacy security-quote enrichment. Not a proposal requirement: no page calls
# the quote routes, and proposals use statement, advisor-entered and approved values.
# Leave unset; their retirement is planned (R18). Exchange rates need no key.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=

# Proposal Copilot. Demo mode (scripted planner, same engine tools, no cost)
# unless BOTH are set: ANTHROPIC_API_KEY and COPILOT_MODE=live. Local use
# only: /api/copilot has no auth, so never set these on a public deployment.
ANTHROPIC_API_KEY=
COPILOT_MODE=
