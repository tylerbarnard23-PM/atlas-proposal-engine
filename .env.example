# Optional legacy security-quote enrichment. Not a proposal requirement: no page calls
# the quote routes, and proposals use statement, advisor-entered and approved values.
# Leave unset; their retirement is planned (R18). Exchange rates need no key.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=

# Proposal Copilot. Demo mode (scripted planner, same engine tools, no cost) by default.
# To use Claude locally, run `npm run local` and paste your key under Connect Claude:
# no file is needed. Setting a key here is the advanced, externally managed option; it
# is used only after you select it in Atlas. Local only: never set these on a public
# deployment (live mode refuses there).
ANTHROPIC_API_KEY=
COPILOT_MODE=
