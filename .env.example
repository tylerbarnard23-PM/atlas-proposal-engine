# All keys are optional. App runs without them using free providers + mock fallbacks.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=

# Proposal Copilot. Without a key the Copilot runs in demo mode (scripted
# planner, same engine tools, no cost). Set COPILOT_MODE=demo to force demo
# mode even when a key is present, e.g. on a public deployment.
ANTHROPIC_API_KEY=
COPILOT_MODE=
