# Optional legacy security-quote enrichment. Not a proposal requirement: no page calls
# the quote routes, and proposals use statement, advisor-entered and approved values.
# Leave unset; their retirement is planned (R18). Exchange rates need no key.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=

# Proposal Copilot. Demo mode (scripted planner, same engine tools, no cost) by default.
# To use Claude locally, run `npm run local` and paste your key under Connect Claude:
# no file is needed. Setting a key here is the advanced, externally managed option; it
# is used only after you select it in Atlas. Local only: never set these on a public
# deployment (live mode refuses there).
ANTHROPIC_API_KEY=
COPILOT_MODE=

# Hosted Claude (#113): COPILOT_MODE=hosted on the public site. Signed-in users connect
# their OWN Anthropic API key, encrypted in Postgres; there is no owner-funded key, and
# ANTHROPIC_API_KEY above is never read in this mode. Without every setting below, the site
# stays the labelled scripted demonstration. Setup: docs/roadmap/HOSTED_CLAUDE.md.
#   COPILOT_MODE=hosted
#   STRATOVELL_PUBLIC_ORIGIN=https://your-site.example     (the exact https origin)
#   DATABASE_URL=postgres://user:password@host/db?sslmode=require
#   STRATOVELL_CREDENTIAL_KEYS=k1:<32 random bytes, base64> (first encrypts; list older ids after it to rotate)
#   GITHUB_CLIENT_ID=                                       (a GitHub OAuth app; callback <origin>/api/auth/github/callback)
#   GITHUB_CLIENT_SECRET=
#   STRATOVELL_ALLOWED_GITHUB_LOGINS=                       (optional, recommended: comma-separated logins allowed to sign in)
# Local checks only (each refused on Vercel and on any non-*.localhost origin):
#   STRATOVELL_DEV_SIGNIN=1  DATABASE_URL=pglite:<folder>  COPILOT_LIVE_PROVIDER=fake
STRATOVELL_PUBLIC_ORIGIN=
DATABASE_URL=
STRATOVELL_CREDENTIAL_KEYS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRATOVELL_ALLOWED_GITHUB_LOGINS=
