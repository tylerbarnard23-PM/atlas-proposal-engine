# All keys are optional. App runs without them using free providers + mock fallbacks.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=

# Proposal Copilot. Demo mode (scripted planner, same engine tools, no cost)
